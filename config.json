          "url_template": "https://{base_url}/{stream} (if not absolute)",
          "parse_as": "json_array",
          "file_path": "[0].file",
          "normalize": ["prefix_double_slash:https:", "prepend_base_url_if_relative"]
        },
        "health_check": {
          "enabled": true,
          "only_for_m3u8": true,
          "fetch_master": true,
          "master_variant_marker": "#EXT-X-STREAM-INF",
          "media_segment_marker": "#EXTINF",
          "probe": {
            "method": "GET",
            "range_header": "bytes=0-0",
            "headers": {"User-Agent": "{ua}", "Referer": "{home_referer}"}
          },
          "rules": {
            "media_without_extinf": "throw:dead_episode",
            "first_segment_4xx": "throw:dead_episode",
            "all_variants_fail_with_4xx": "throw:dead_episode"
          },
          "error_messages": {
            "dead_episode": "ตอนนี้ถูกลบออกจากระบบแล้ว กรุณาเลือกตอนอื่น"
          }
        },
        "legacy_html": {
          "meta_content_url_selector": "meta[itemprop=contentUrl]",
          "meta_file_selector": "meta[name=file]",
          "hd_replace": {"from": "c2Q=/master.m3u8", "to": "aGQ=/master.m3u8"},
          "head_probe_accept_codes": [200, 405],
          "script_patterns": [
            {"pattern": "\"file\"\\s*:\\s*\"([^\"]+\\.m3u8)\""},
            {"pattern": "sources:\\s*\\[\\s*\\{\\s*file:\\s*\"([^\"]+\\.m3u8)\""},
            {"pattern": "(https?://[^\\s\"']+\\.m3u8[^\\s\"']*)"}
          ],
          "error_message": "ไม่พบลิงก์วิดีโอในหน้า"
        }
      }
    },

    "WOWDRAMA": {
      "source_class": "WowDramaSource",
      "parser_class": "WowDramaParser",
      "base_url_template": "https://{base_url}{home_page}",
      "search_url_template": "https://{base_url}/?s={keyword}",
      "list": {
        "item_selectors": ["div.-movie", "article.movie", ".movies article", ".item-movies"],
        "link_selector": "div.pic a, .poster a, a[href]",
        "url_attr": "abs:href",
        "url_fallback_attr": "href",
        "title_selectors": ["h2.entry-title a", ".title a", "h2 a", "h3 a"],
        "title_fallbacks": ["img.alt", "link.title"],
        "image_selector": "div.pic img, .poster img, img",
        "image_attrs": [
          "data-wpfc-original-src", "data-src", "data-lazy-src", "data-original",
          "data-original-src", "data-src-retina", "data-cfsrc", "data-lazy", "src",
          "data-wpfc-original-srcset", "data-srcset", "data-lazy-srcset", "srcset"
        ],
        "poster_fallback": {
          "selector": "[data-bg], [data-background], [style*=background-image]",
          "attrs": ["data-bg", "data-background"],
          "style_pattern": "url\\(['\"]?([^)'\"]+)"
        },
        "subtitle_selector": "div.imdb, .imdb, .quality"
      },
      "pagination": {
        "container_selector": "div.content-pagination",
        "prev_selector": "a.prev.page-numbers",
        "next_selector": "a.next.page-numbers",
        "link_selector": "a.page-numbers:not(.prev):not(.next)"
      },
      "detail": {
        "title_selector": "meta[property=og:title]",
        "title_transform": "strip_chars:[\\[\\].:]|trim",
        "image_selector": "meta[property=og:image]",
        "nonce_extraction": {
          "script_iterator": "script",
          "pattern": "miruNonce\\s*=\\s*\"([^\"]+)\"",
          "stored_as": "miruNonce"
        }
      },
      "episodes": {
        "element_selector": "div.miru-ep-btn[data-ep-id], span.episode[episode-id], .mp-ep-btn[data-id]",
        "id_attrs_priority": ["data-ep-id", "episode-id", "data-id"],
        "title_attrs": ["title"],
        "title_inner_selector": ".miru-ep-title",
        "title_template": "ตอนที่ {n}",
        "fake_url_template": "{referer}?episode-id={episode_id}"
      },
      "video": {
        "strategy": "ajax_post_multi_server",
        "ajax": {
          "url_template": "https://{domain}/wp-admin/admin-ajax.php",
          "method": "POST",
          "action": "miru_get_api_player_url",
          "server_iterations": [0, 1],
          "body": {
            "action": "miru_get_api_player_url",
            "ep_id": "{episode_id}",
            "server_idx": "{server_idx}",
            "nonce": "{nonce}"
          },
          "headers": {
            "User-Agent": "Mozilla/5.0",
            "Referer": "{referer}",
            "Origin": "https://{domain}",
            "X-Requested-With": "XMLHttpRequest"
          },
          "nonce_source": ["epDoc_script", "cached_miruNonce"],
          "response_parsers": [
            {"type": "torbo_stream", "pattern": "{stream_host}/(?:embed|play)/([A-Za-z0-9]{32})"},
            {"type": "jwplayer", "patterns": [
              "sources:\\s*\\[\\s*\\{\\s*file:\\s*\"([^\"]+\\.m3u8)\"",
              "\"sources\"\\s*:\\s*\\[\\s*\\{\\s*\"file\"\\s*:\\s*\"([^\"]+\\.m3u8)\""
            ]},
            {"type": "json_success_player_primary", "path": "player.primary"},
            {"type": "json_success_data_url", "path": "data.url"},
            {"type": "json_player_data_servers", "path": "player.data.*[].url"},
            {"type": "iframe", "selector": "iframe[src]"}
          ],
          "success_false_capture": {
            "message_paths": ["data.message"],
            "fallback_message": "API success=false"
          }
        },
        "fallback": [
          {"type": "direct_url_pattern", "pattern": "(https?:\\/\\/[^\\s\"']+\\.(?:m3u8|mp4|mkv|webm))", "exclude": ["localhost", "127.0.0.1"]},
          {"type": "iframe_pattern", "pattern": "<iframe[^>]+src=[\"']([^\"']+)[\"']"},
          {"type": "script_json_pattern", "pattern": "\"(?:file|url|src)\"\\s*:\\s*\"([^\"]+\\.(?:m3u8|mp4))\""},
          {"type": "script_js_pattern", "pattern": "(?:videoSources|sources|jwplayer\\().*?file.*?\"(https?:\\\\/\\\\/[^\"]+)\""},
          {"type": "backup_server_selector", "selector": "div.mp-s-sl", "attr": "data-id"}
        ],
        "iframe_processing": {
          "order": ["torbo_stream", "getplay_stream", "original_iframe", "direct_url", "nested_iframe", "script"],
          "torbo": {
            "pattern": "{stream_host}/(?:embed|play)/([A-Za-z0-9]{32})",
            "resolver": "GetplayStreamResolver.resolve"
          },
          "getplay": {
            "cdn_hosts": {"ok-hd": "ok-hd.com", "getplay-cdn": "getplay-cdn.com"},
            "patterns": [
              "https?://(?:getplay-cdn|ok-hd)\\.com/(?:embed|play)/([A-Za-z0-9_-]{20,})",
              "(?:getplay-cdn|ok-hd)\\.com/api/stream/([A-Za-z0-9_-]{20,})/index\\.m3u8",
              "(?:getplay-cdn|ok-hd)\\.com/(?:embed|play)/([A-Za-z0-9_-]{20,})"
            ],
            "parent_default": "wow-drama.com"
          },
          "original_iframe": {
            "script_marker": "videoSources",
            "video_server_pattern": "\"videoServer\":\"(\\d+)\"",
            "video_sources_pattern": "\"videoSources\":\\[\\{\"file\":\"([^\"]+)\"",
            "host_list_pattern": "\"hostList\":(\\{.*?\\})",
            "url_transform": {
              "from": "https:\\\\/\\\\/\\d+\\\\/cdn\\\\/hls\\\\/",
              "to": "https://{domain}/api/files/",
              "unescape": true
            }
          }
        }
      }
    }
  },

  "shared": {
    "domain_config": {
      "base_url": "{DomainConfig.BaseUrl.*}",
      "home_page": "{DomainConfig.HomePage.*}",
      "source_name": "{DomainConfig.SourceName.*}",
      "play_api": "{DomainConfig.ApiUrl.PLAY_API}",
      "get_api": "{DomainConfig.ApiUrl.GET_API}",
      "play_animemoji": "{DomainConfig.ApiUrl.PLAY_ANIMEMOJI}",
      "getplay_stream_api": "{DomainConfig.ApiUrl.GETPLAY_STREAM_API}"
    },
    "http": {
      "client_factory": "OkHttpClientFactory.getClientWithDoH",
      "default_ua": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
      "challenge_ua": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
      "watchlakorn_ua": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    },
    "resolvers": {
      "getplay_stream": "GetplayStreamResolver.resolve(streamBase, id, parent, client)",
      "torbo_stream_parent": "domain or stream_host",
      "getplay_stream_parent_defaults": {
        "Fixmono": "flixmono.com",
        "WowDrama": "wow-drama.com"
      }
    },
    "models": {
      "anime": "Anime(title, url, image, episodes)",
      "episode": "Episode(title, url, imageUrl, videoUrl, referer, number)",
      "anime_item": "AnimeItem(title, url, imageUrl, subtitleText[, latestEpisode])",
      "page_item": "PageItem(number, url, isActive)",
      "host_list": "HostListModel.hostList: Map<String, List<String>>"
    },
    "interface": {
      "AnimeSource": ["getSourceName", "getBaseUrl", "getSearchUrl", "fetchAnimeList", "cleanup"],
      "AnimeParser": ["parseAnimeDetail", "parseEpisodes", "parseVideoUrl"],
      "AnimeLoadCallback": ["onSuccess(animeItems, pageItems)", "onFailure(errorMessage)"]
    }
  },

  "remote_update": {
    "enabled": true,
    "transport": "https_get_json",
    "cache_ttl_seconds": 3600,
    "fallback_to_bundled": true,
    "field_overrides": [
      "app_config.sources",
      "app_config.metadata",
      "parsers.{NAME}.list.*",
      "parsers.{NAME}.pagination.*",
      "parsers.{NAME}.detail.*",
      "parsers.{NAME}.episodes.*",
      "parsers.{NAME}.video.*",
      "parsers.{NAME}.base_url_template",
      "parsers.{NAME}.search_url_template",
      "shared.resolvers.*"
    ],
    "safety": {
      "validate_json_schema": true,
      "require_version_monotonic": true,
      "reject_empty_required_fields": true
    }
  }
}