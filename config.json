  "parsers": {
    "FIXMONO": {
      "source_class": "FixmonoSource",
      "parser_class": "FixmonoParser",
      "base_url_template": "https://{base_url}{home_page}",
      "search_url_template": "https://{base_url}/?s={keyword}",
      "list": {
        "item_selector": "article",
        "link_selector": "a[rel=bookmark]",
        "title_attr": "title",
        "url_attr": "href",
        "image_selector": "img.wp-post-image",
        "image_attrs": ["data-src", "src"],
        "subtitle_selector": "span.lang-22-color"
      },
      "pagination": {
        "link_selector": "div.pagination a.page-link:not(.dots)",
        "active_selector": ["div.pagination li.active a.page-link", "div.pagination .page-item.active .page-link"]
      },
      "detail": {
        "title_selector": "meta[property=og:title]",
        "title_transform": "strip_chars:[\\[\\].:]|trim",
        "image_selector": "meta[property=og:image]"
      },
      "episodes": {
        "element_selector": "span.episode[episode-id], .mp-ep-btn[data-id]",
        "id_attrs": ["episode-id", "data-id"],
        "fake_url_template": "{referer}?episode-id={episode_id}",
        "title_template": "ตอนที่ {n}"
      },
      "video": {
        "strategy": "ajax_post_then_fallback",
        "ajax": {
          "url_template": "https://{domain}/wp-admin/admin-ajax.php",
          "method": "POST",
          "action": "mix_get_player",
          "body": {"action": "mix_get_player", "post_id": "{episode_id}"},
          "headers": {
            "User-Agent": "Mozilla/5.0",
            "Referer": "{referer}",
            "X-Requested-With": "XMLHttpRequest"
          },
          "response_parsers": [
            {"type": "torbo_stream", "pattern": "{stream_host}/(?:embed|play)/([A-Za-z0-9]{32})"},
            {"type": "jwplayer", "patterns": [
              "sources:\\s*\\[\\s*\\{\\s*file:\\s*\"([^\"]+\\.m3u8)\"",
              "\"sources\"\\s*:\\s*\\[\\s*\\{\\s*\"file\"\\s*:\\s*\"([^\"]+\\.m3u8)\""
            ]},
            {"type": "json", "paths": ["player.primary", "player.data.*[].url"]},
            {"type": "iframe", "selector": "iframe[src]"}
          ]
        },
        "fallback": [
          {"type": "direct_url_pattern", "pattern": "(https?:\\/\\/[^\\s\"']+\\.(?:m3u8|mp4|mkv|webm))", "exclude": ["localhost", "127.0.0.1"]},
          {"type": "iframe_pattern", "pattern": "<iframe[^>]+src=[\"']([^\"']+)[\"']"},
          {"type": "script_json_pattern", "pattern": "\"(?:file|url|src)\"\\s*:\\s*\"([^\"]+\\.(?:m3u8|mp4))\""},
          {"type": "script_js_pattern", "pattern": "(?:videoSources|sources|jwplayer\\().*?file.*?\"(https?:\\\\/\\\\/[^\"]+)\""},
          {"type": "backup_server_selector", "selector": "div.mp-s-sl", "attr": "data-id"}
        ],
        "iframe_processing": {
          "order": ["torbo_stream", "getplay_stream", "original_iframe", "direct_url", "nested_iframe", "script"],
          "torbo": {"pattern": "{stream_host}/(?:embed|play)/([A-Za-z0-9]{32})"},
          "getplay": {
            "patterns": [
              "https?://(?:getplay-cdn|moddepp)\\.com/(?:embed|play)/([A-Za-z0-9_-]{20,})",
              "(?:getplay-cdn|moddepp)\\.com/api/stream/([A-Za-z0-9_-]{20,})/index\\.m3u8",
              "(?:getplay-cdn|moddepp)\\.com/(?:embed|play)/([A-Za-z0-9_-]{20,})"
            ],
            "cdn_hosts": {"moddepp": "moddepp.com", "getplay-cdn": "getplay-cdn.com"}
          },
          "original_iframe": {
            "script_marker": "videoSources",
            "video_server_pattern": "\"videoServer\":\"(\\d+)\"",
            "video_sources_pattern": "\"videoSources\":\\[\\{\"file\":\"([^\"]+)\"",
            "host_list_pattern": "\"hostList\":(\\{.*?\\})",
            "url_transform": {
              "from": "https:\\\\/\\\\/\\d+\\\\/cdn\\\\/hls\\\\/",
              "to": "https://{domain}/api/files/",
              "unescape": true
            }
          }
        }
      }
    },

    "ANIMEMOJI": {
      "source_class": "AnimemojiSource",
      "parser_class": "AnimemojiParser",
      "base_url_template": "https://{base_url}{home_page}",
      "search_url_template": "https://{base_url}/?s={keyword}",
      "list": {
        "item_selector": "article.ez-postthumb",
        "link_selector": "a.ez-pt-link",
        "title_attr": "title",
        "url_attr": "href",
        "image_selector": "img",
        "image_attrs": ["data-src", "src", "data-srcset"],
        "subtitle_selector": "span.ez-index-tag",
        "subtitle_filter": "has_child:i.fa.fa-bolt"
      },
