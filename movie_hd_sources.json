        }
      ],
      "home_page": "/api.php?action=get_latest&page=1",
      "search": "https://{domain}/api.php?action=search&q={keyword}",
      "list": {
        "format": "json",
        "items": "items",
        "title": "{title}",
        "url": "https://{domain}/api.php?action=get_series_detail&id={category_id}&category_id={category_id}&page=1",
        "image": "{image}",
        "latest_episode": "ตอน {total_episodes}"
      },
      "pagination": {
        "total_pages": "total_pages",
        "param": "page"
      },
      "detail": {
        "title": [
          "meta[property=og:title]@content",
          "h1@text",
          "title@text"
        ],
        "image": [
          "meta[property=og:image]@content",
          "img@src"
        ]
      },
      "episodes": {
        "mode": "steps",
        "steps": [
          {
            "do": "fetch",
            "url": "{page_url}",
            "referer": "{base}/",
            "as": "episodes_json"
          }
        ],
        "items_from": "episodes_json",
        "items_paths": [
          "episodes"
        ],
        "number": "{episode}",
        "title": "{episode_display}",
        "title_template": "ตอนที่ {n}",
        "url": "https://{domain}/api.php?action=get_player&id={id}"
      },
      "scheme": "https",
      "video": {
        "steps": [
          {
            "do": "fetch",
            "url": "{page_url}",
            "referer": "{referer}",
            "as": "player_json"
          },
          {
            "do": "json",
            "from": "player_json",
            "paths": [
              "video.stream_url",
              "video.playlist_url",
              "video.playlist",
              "stream_url",
              "playlist_url",
              "playlist"
            ],
            "as": "stream_url",
            "optional": true
          },
          {
            "do": "require",
            "var": "stream_url",
            "message": "Watch Lakorn API ไม่มี stream_url/playlist"
          },
          {
            "do": "url",
            "action": "resolve",
            "from": "stream_url",
            "as": "stream_absolute",
            "base": "{base}"
          },
          {
            "do": "if",
            "var": "stream_absolute",
            "matches": "content_jw6\\.php|content_jw",
            "then": [
              {
                "do": "fetch",
                "url": "{stream_absolute}",
                "referer": "{referer}",
                "as": "jw_playlist_json"
              },
              {
                "do": "json",
                "from": "jw_playlist_json",
                "paths": [
                  "[0].file",
                  "0.file",
                  "file"
                ],
                "as": "jw_file",
                "optional": true
              },
              {
                "do": "require",
                "var": "jw_file",
                "message": "JW playlist ไม่พบ file URL"
              },
              {
                "do": "url",
                "action": "resolve",
                "from": "jw_file",
                "as": "jw_absolute",
                "base": "{stream_absolute}"
              },
              {
                "do": "return",
                "value": "{jw_absolute}"
              }
            ]
          },
          {
            "do": "return",
            "value": "{stream_absolute}"
          }
        ]
      }
    }
  ]
}
