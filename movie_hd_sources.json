{
  "version": 1,
  "description": "MOVIE HD online source - 123HDD episode selector supports table and dropdown formats.",
  "stream_rules": [
    {
      "match": "main.24playerhd.com",
      "referer_template": "{video_url|origin}/"
    }
  ],
  "sources": [
    {
  "id": "movie24hd",
  "logo": "",
  "name": "24HD",
  "domain": "www.24-hdc.com",
  "categories": [
    {
      "id": "cat_1314859596059",
      "path": "/",
      "title": "หนังออนไลน์"
    },
    {
      "id": "cat_8611098134462",
      "path": "/หนังใหม่-2026/",
      "title": "หนังใหม่-2026"
    },
    {
      "id": "cat_7468327399272",
      "path": "/หนังใหม่-2025/",
      "title": "หนังใหม่-2025"
    },
    {
      "id": "cat_8488012579748",
      "path": "/หนังใหม่-2024/",
      "title": "หนังใหม่-2024"
    },
    {
      "id": "cat_5539385363047",
      "path": "/marvel-universe/",
      "title": "หนัง Marvel Universe"
    },
    {
      "id": "cat_1131198557564",
      "path": "/หนังชนโรง/",
      "title": "หนังชนโรง"
    },
    {
      "id": "cat_5672703734208",
      "path": "/หนังไทย/",
      "title": "หนังไทย"
    },
    {
      "id": "cat_5084937629708",
      "path": "/dc-universe/",
      "title": "หนัง DC Universe"
    },
    {
      "id": "cat_7990200419913",
      "path": "/netflix/",
      "title": "หนัง NETFLIX"
    }
  ],
  "home_page": "/",
  "search": "https://{domain}/search_movie?keyword={keyword}",
  "list": {
    "item": "div.box",
    "link": "a@href",
    "title": "div.p2@text",
    "image": "img@data-lazy-src|src",
    "subtitle": "div.p1@text"
  },
  "pagination": {
    "link": "a.page-numbers:not(.prev):not(.next)",
    "active": "span.page-numbers.current"
  },
  "detail": {
    "title": "meta[property=og:title]@content",
    "image": "meta[property=og:image]@content"
  },
  "episodes": {
    "item": "li.halim-episode span.halim-btn[data-episode]",
    "title": "@data-title|text",
    "number": "@data-episode",
    "url_template": "{page_url}?episode={n}",
    "number_regex": "(\\d+)",
    "order": "asc"
  },
  "scheme": "https",
  "video": {
    "steps": [
      {
        "do": "regex",
        "from": "page_html",
        "patterns": [
          "(?:var\\s+(?:halim_nonce|ajax_nonce|nonce)\\s*=\\s*['\\\"])([^'\\\"]+)",
          "['\\\"]?nonce['\\\"]?\\s*[:=]\\s*['\\\"]([a-zA-Z0-9_-]+)['\\\"]"
        ],
        "group": 1,
        "as": "nonce_regex",
        "optional": true
      },
      {
        "do": "css",
        "from": "page_html",
        "sel": [
          "span.halim-btn.active@data-post-id",
          "span.halim-btn@data-post-id",
          "[data-post-id]@data-post-id"
        ],
        "as": "post_id_dom",
        "optional": true
      },
      {
        "do": "regex",
        "from": "page_html",
        "pattern": "(?:post[_-]?id|postid|postID)[^0-9]{0,16}([0-9]{3,})",
        "group": 1,
        "as": "post_id_regex",
        "optional": true
      },
      {
        "do": "css",
        "from": "page_html",
        "sel": [
          "span.halim-btn.active@data-episode",
          "span.halim-btn@data-episode"
        ],
        "as": "episode_dom",
        "optional": true
      },
      {
        "do": "first_non_empty",
        "vars": [
          "q_episode",
          "q_episode-id",
          "q_episode_id",
          "episode_number",
          "episode_dom"
        ],
        "default": "1",
        "as": "episode"
      },
      {
        "do": "first_non_empty",
        "vars": [
          "nonce_regex"
        ],
        "default": "",
        "as": "nonce"
      },
      {
        "do": "first_non_empty",
        "vars": [
          "post_id_dom",
          "post_id_regex"
        ],
        "default": "",
        "as": "post_id"
      },
      {
        "do": "first_non_empty",
        "vars": [
          "server"
        ],
        "default": "1",
        "as": "server"
      },
      {
        "do": "css",
        "from": "page_html",
        "sel": "#Lang_select option[selected]@value|text",
        "as": "lang",
        "optional": true
      },
      {
        "do": "first_non_empty",
        "vars": [
          "lang"
        ],
        "default": "Thai",
        "as": "lang"
      },
      {
        "do": "require",
        "var": "post_id",
        "message": "ไม่พบ post_id ในหน้า Player"
      },
      {
        "do": "require",
        "var": "nonce",
        "message": "ไม่พบ nonce/type สำหรับ Player API"
      },
      {
        "do": "require",
        "var": "episode",
        "message": "ไม่พบรหัสตอนสำหรับ Player API"
      },
      {
        "do": "fetch",
        "url": "https://api.24-hdc.com/get.php",
        "method": "POST",
        "referer": "{referer}",
        "headers": {
          "User-Agent": "{ua}",
          "Referer": "{referer}",
          "Origin": "{base}",
          "X-Requested-With": "XMLHttpRequest"
        },
        "form": {
          "action": "halim_ajax_player",
          "nonce": "{nonce}",
          "episode": "{episode}",
          "postid": "{post_id}",
          "server": "{server}",
          "lang": "{lang}"
        },
        "as": "player_response"
      },
      {
        "do": "replace",
        "from": "player_response",
        "find": "\\\\/",
        "with": "/",
        "as": "player_unescaped"
      },
      {
        "do": "regex",
        "from": "player_unescaped",
        "patterns": [
          "(https?://[^\\s\"\\'<>]+?\\.(?:m3u8|mp4)(?:\\?[^\\s\"\\'<>]*)?)",
          "<iframe[^>]+src\\s*=\\s*['\\\"]([^'\\\"]+)['\\\"]",
          "(https?://main\\.24playerhd\\.com/[^\\s\"\\'<>]+)"
        ],
        "group": 1,
        "as": "player_url",
        "optional": true
      },
      {
        "do": "if",
        "var": "player_url",
        "matches": "\\.(?:m3u8|mp4)(?:[?#]|$)",
        "then": [
          {
            "do": "return",
            "value": "{player_url}"
          }
        ]
      },
      {
        "do": "require",
        "var": "player_url",
        "message": "API ไม่ส่ง iframe หรือ media URL กลับมา"
      },
      {
        "do": "regex",
        "from": "player_url",
        "pattern": "(?:[?&]id=)([^&]+)",
        "group": 1,
        "as": "playlist_id",
        "optional": true
      },
      {
        "do": "require",
        "var": "playlist_id",
        "message": "ไม่พบ id ใน URL ของ iframe Player"
      },
      {
        "do": "return",
        "value": "https://main.24playerhd.com/newplaylist/{playlist_id}/{playlist_id}.m3u8"
      }
    ]
  }
}
    ]
  }

  
