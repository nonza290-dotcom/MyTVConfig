{
  "version": 6,
  "description": "MovieHD Engine-Only Online JSON - 24HD (24-hdc.com)",
  "stream_rules": [],
  "sources": [
    {
      "id": "movie24hd",
      "name": "24HD",
      "domain": "24-hdc.com",
      "extra_domains": ["www.24-hdc.com", "24-hda.com"],
      "scheme": "https",
      "enabled": true,
      "headers": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
        "Referer": "https://www.24-hdc.com/"
      },
      "categories": [
        { "id": "cat_1314859596059", "title": "หนังออนไลน์", "path": "/" },
        { "id": "cat_6171044715209", "title": "ดูซีรีย์", "path": "/series/" },
        { "id": "cat_8611098134462", "title": "หนังใหม่-2026", "path": "/หนังใหม่-2026/" },
        { "id": "cat_7468327399272", "title": "หนังใหม่-2025", "path": "/หนังใหม่-2025/" },
        { "id": "cat_8488012579748", "title": "หนังใหม่-2024", "path": "/หนังใหม่-2024/" },
        { "id": "cat_1131198557564", "title": "หนังชนโรง", "path": "/หนังชนโรง/" },
        { "id": "cat_5672703734208", "title": "หนังไทย", "path": "/หนังไทย/" },
        { "id": "cat_5539385363047", "title": "หนัง Marvel Universe", "path": "/marvel-universe/" },
        { "id": "cat_5084937629708", "title": "หนัง DC Universe", "path": "/dc-universe/" },
        { "id": "cat_7990200419913", "title": "หนัง NETFLIX", "path": "/netflix/" }
      ],
      "search": "https://{domain}/search_movie?keyword={keyword}",
      "list": {
        "item": "div.grid-movie:nth-of-type(2) div.box, div.grid-movie div.box",
        "link": "a@href",
        "title": "div.p2",
        "image": "img@data-lazy-src|src",
        "subtitle": "div.p1"
      },
      "pagination": {
        "link": "nav.navigation.pagination a.page-numbers:not(.prev):not(.next)",
        "active": "nav.navigation.pagination span.page-numbers.current"
      },
      "detail": {
        "title": "meta[property=og:title]@content",
        "image": "meta[property=og:image]@content"
      },
      "episodes": {
        "selector": "li.halim-episode span.halim-btn",
        "title_template": "ตอนที่ {n}"
      },
      "video": {
        "steps": [
          {
            "do": "fetch",
            "method": "GET",
            "url": "{episode_url}",
            "headers": {
              "Referer": "https://{domain}/"
            },
            "into": "detail_html"
          },
          {
            "do": "regex",
            "from": "detail_html",
            "patterns": [
              "(?:var\\s+halim_nonce\\s*=\\s*['\"]|\"nonce\"\\s*:\\s*\")([a-f0-9]+)(?:['\"]|\")"
            ],
            "group": 1,
            "optional": true,
            "into": "nonce"
          },
          {
            "do": "regex",
            "from": "detail_html",
            "patterns": [
              "\"post_id\"\\s*:\\s*\"?(\\d+)\"?",
              "data-post-id=[\"'](\\d+)[\"']",
              "postid[\"']?\\s*[:=]\\s*[\"']?(\\d+)"
            ],
            "group": 1,
            "optional": true,
            "into": "post_id"
          },
          {
            "do": "try",
            "steps": [
              {
                "do": "fetch",
                "method": "POST",
                "url": "https://api.24-hdc.com/get.php",
                "form": {
                  "action": "halim_ajax_player",
                  "nonce": "{nonce}",
                  "episode": "{episode_number}",
                  "postid": "{post_id}",
                  "server": "1",
                  "lang": "Sound Track"
                },
                "headers": {
                  "Referer": "{episode_url}",
                  "Origin": "https://{domain}",
                  "X-Requested-With": "XMLHttpRequest"
                },
                "into": "ajax_resp"
              },
              {
                "do": "regex",
                "from": "ajax_resp",
                "patterns": [
                  "[?&]id=([^&\"']+)",
                  "https?:\\/\\/main\\.24playerhd\\.com\\/newplaylist\\/([^/\"'\\s]+)"
                ],
                "group": 1,
                "optional": true,
                "into": "stream_id"
              },
              {
                "do": "if",
                "cond": "not_empty:stream_id",
                "then": [
                  {
                    "do": "return",
                    "value": "https://main.24playerhd.com/newplaylist/{stream_id}/{stream_id}.m3u8"
                  }
                ]
              },
              {
                "do": "regex",
                "from": "ajax_resp",
                "patterns": [
                  "(https?:\\/\\/[^\\s\"']+\\.(?:m3u8|mp4|mkv|webm)[^\\s\"']*)",
                  "<iframe[^>]+src=[\"']([^\"']+)[\"']"
                ],
                "group": 1,
                "optional": true,
                "into": "direct_or_iframe"
              },
              {
                "do": "if",
                "cond": "not_empty:direct_or_iframe",
                "then": [
                  { "do": "return", "value": "{direct_or_iframe}" }
                ]
              }
            ]
          },
          {
            "do": "regex",
            "from": "detail_html",
            "patterns": [
              "(https?:\\/\\/[^\\s\"']+\\.(?:m3u8|mp4|mkv|webm)[^\\s\"']*)",
              "<iframe[^>]+src=[\"']([^\"']+)[\"']"
            ],
            "group": 1,
            "optional": true,
            "into": "fallback_url"
          },
          {
            "do": "return",
            "value": "{fallback_url}"
          }
        ]
      }
    }
  ]
}
