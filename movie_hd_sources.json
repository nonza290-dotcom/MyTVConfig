        }
      ],
      "home_page": "/ซีรี่ย์จีน/",
      "search": "https://{domain}/search_movie/?keyword={keyword}",
      "list": {
        "item": "div.grid-movie > div.box",
        "link": "a@href",
        "title": ".p-box .p2@text",
        "image": ".box-img img@data-lazy-src|src",
        "subtitle": ".p-box .p1@text"
      },
      "pagination": {
        "link": ".pagination a.page-numbers:not(.next):not(.prev)",
        "active": "span.current"
      },
      "detail": {
        "title": "meta[property=og:title]@content",
        "image": "meta[property=og:image]@content"
      },
      "episodes": {
        "item": "select[name=Sequel_select] option",
        "url": "@value",
        "title": "@text",
        "number_regex": "(\\d+)",
        "order": "asc"
      },
      "scheme": "https",
      "video": {
        "steps": [
          {
            "do": "css",
            "from": "page_html",
            "sel": "span.halim-btn.halim-btn-2.active.halim-info-2-1.box-shadow@data-post-id",
            "as": "post_id",
            "optional": true
          },
          {
            "do": "css",
            "from": "page_html",
            "sel": "span.halim-btn.halim-btn-2.active.halim-info-2-1.box-shadow@data-server",
            "as": "server",
            "optional": true
          },
          {
            "do": "css",
            "from": "page_html",
            "sel": "span.halim-btn.halim-btn-2.active.halim-info-2-1.box-shadow@data-type",
            "as": "nonce",
            "optional": true
          },
          {
            "do": "first_non_empty",
            "vars": [
              "q_episode",
              "q_episode-id",
              "q_episode_id",
              "episode_number"
            ],
            "as": "episode"
          },
          {
            "do": "first_non_empty",
            "vars": [
              "nonce"
            ],
            "default": "",
            "as": "nonce"
          },
          {
            "do": "first_non_empty",
            "vars": [
              "post_id"
            ],
            "default": "",
            "as": "post_id"
          },
          {
            "do": "first_non_empty",
            "vars": [
              "server"
            ],
            "default": "3",
            "as": "server"
          },
          {
            "do": "css",
            "from": "page_html",
            "sel": "#Lang_select option[selected]@value|text",
            "as": "lang",
            "optional": true
          },
          {
            "do": "first_non_empty",
            "vars": [
              "lang"
            ],
            "default": "Thai",
            "as": "lang"
          },
          {
            "do": "require",
            "var": "post_id",
            "message": "ไม่พบ post_id ในหน้า Player"
          },
          {
            "do": "require",
            "var": "nonce",
            "message": "ไม่พบ nonce/type สำหรับ Player API"
          },
          {
            "do": "require",
            "var": "episode",
            "message": "ไม่พบรหัสตอนสำหรับ Player API"
          },
          {
            "do": "fetch",
            "url": "{base}/api/get.php",
            "method": "POST",
            "referer": "{referer}",
            "headers": {
              "User-Agent": "{ua}",
              "Referer": "{referer}",
              "Origin": "{base}",
              "X-Requested-With": "XMLHttpRequest"
            },
            "form": {
              "action": "halim_ajax_player",
              "nonce": "{nonce}",
              "episode": "{episode}",
              "postid": "{post_id}",
              "server": "{server}",
              "lang": "{lang}"
            },
            "as": "player_response"
          },
          {
            "do": "replace",
            "from": "player_response",
            "find": "\\\\/",
            "with": "/",
            "as": "player_unescaped"
          },
          {
            "do": "regex",
            "from": "player_unescaped",
            "patterns": [
              "(https?://[^\\s\"\\'<>]+?\\.(?:m3u8|mp4)(?:\\?[^\\s\"\\'<>]*)?)",
              "<iframe[^>]+src\\s*=\\s*[\\'\\\"]([^\\'\\\"]+)[\\'\\\"]"
            ],
            "group": 1,
            "as": "player_url",
            "optional": true
          },
          {
            "do": "if",
            "var": "player_url",
            "matches": "\\.(?:m3u8|mp4)(?:[?#]|$)",
            "then": [
              {
                "do": "return",
                "value": "{player_url}"
              }
            ]
          },
          {
            "do": "require",
            "var": "player_url",
            "message": "API ไม่ส่ง iframe หรือ media URL กลับมา"
          },
          {
            "do": "regex",
            "from": "player_url",
            "pattern": "(?:[?&]id=)([^&]+)",
            "group": 1,
            "as": "playlist_id",
            "optional": true
          },
          {
            "do": "require",
            "var": "playlist_id",
            "message": "ไม่พบ id ใน URL ของ iframe Player"
          },
          {
            "do": "return",
            "value": "https://main.24playerhd.com/newplaylist/{playlist_id}/{playlist_id}.m3u8"
          }
        ]
      }
    }
  ]
},
{
