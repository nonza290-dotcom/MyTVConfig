{
  "version": 1,
  "description": "MOVIE HD online source - Fixmono. Migrated from legacy Fixmono parser settings.",
  "stream_rules": [],
  "sources": [
    {
      "id": "fixmono",
      "name": "Fixmono",
      "domain": "flixmono2.com",
      "scheme": "https",
      "categories": [
        {
          "id": "cat_1436422493588",
          "path": "/serie/",
          "title": "ซีรี่ย์อัพเดท"
        },
        {
          "id": "cat_6912707317315",
          "path": "/category/ซีรี่ย์จีนพากย์ไทย/",
          "title": "ซีรี่ย์จีนพากย์ไทย"
        },
        {
          "id": "cat_5096833638035",
          "path": "/category/ซีรี่ย์จีนซับไทย/",
          "title": "ซีรี่ย์จีนซับไทย"
        },
        {
          "id": "cat_8410071943871",
          "path": "/category/ซีรี่ย์เกาหลีพากย์ไทย/",
          "title": "ซีรี่ย์เกาหลีพากย์ไทย"
        },
        {
          "id": "cat_7180316056242",
          "path": "/category/ซีรี่ย์เกาหลีซับไทย/",
          "title": "ซีรี่ย์เกาหลีซับไทย"
        },
        {
          "id": "cat_7029773549828",
          "path": "/category/ดูซีรี่ย์ฝรั่ง/",
          "title": "ซีรี่ย์ฝรั่ง"
        },
        {
          "id": "cat_3095922612902",
          "path": "/category/ดูซีรี่ย์ญี่ปุ่น/",
          "title": "ซีรี่ย์ญี่ปุ่น"
        }
      ],
      "search": "{base}/?s={keyword}",
      "list": {
        "item": "article",
        "link": "a[rel=bookmark]@href",
        "title": "a[rel=bookmark]@title|text",
        "image": "img.wp-post-image@data-src|src",
        "subtitle": "span.lang-22-color@text"
      },
      "pagination": {
        "link": "div.pagination a.page-link:not(.dots)",
        "active": "div.pagination li.active a.page-link, div.pagination .page-item.active .page-link"
      },
      "detail": {
        "title": "meta[property=og:title]@content",
        "title_strip": [
          "[\\[\\].:]"
        ],
        "image": "meta[property=og:image]@content"
      },
      "episodes": {
        "item": "span.episode[episode-id], .mp-ep-btn[data-id]",
        "id": "@episode-id|data-id",
        "url": "{referer}?episode-id={id}",
        "title": "@text",
        "title_template": "ตอนที่ {n}",
        "order": "asc"
      },
      "video": {
        "steps": [
          {
            "do": "http_post",
            "url": "{base}/wp-admin/admin-ajax.php",
            "headers": {
              "Referer": "{referer}",
              "X-Requested-With": "XMLHttpRequest"
            },
            "body": {
              "action": "mix_get_player",
              "post_id": "{episode_id}"
            },
            "as": "ajax_res"
          },
          {
            "do": "css",
            "from": "ajax_res",
            "sel": "iframe@src",
            "as": "iframe_url"
          },
          {
            "do": "regex",
            "from": "ajax_res",
            "pattern": "(https?://[^\\s\"']+\\.(?:m3u8|mp4|mkv|webm))",
            "group": 1,
            "as": "direct_url"
          },
          {
            "do": "first_non_empty",
            "vars": [
              "direct_url",
              "iframe_url"
            ],
            "as": "target_url"
          },
          {
            "do": "require",
            "var": "target_url",
            "message": "ไม่พบลิงก์เล่นวิดีโอจาก Fixmono"
          },
          {
            "do": "return",
            "value": "{target_url}"
          }
        ]
      }
    }
  ]
}
